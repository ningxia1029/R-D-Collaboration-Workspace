# 仅作变量清单；复制后必须由部署平台 Secret 覆盖，禁止提交真实值。
DATABASE_URL=postgresql://APP_USER:URL_ENCODED_PASSWORD@DB_HOST:5432/APP_DATABASE?sslmode=require&connect_timeout=5&pool_timeout=5
AUTH_SECRET=
AUTH_TRUST_HOST=true
NEXT_PUBLIC_DEMO_MODE=false
DEPLOYMENT_ENV=production
AUTH_RATE_LIMIT_MODE=gateway

# Agent 暂不上线时保持这些变量未配置，并在系统管理中保持总开关关闭。
AGENT_INTERNAL_SERVICE_SECRET=
AGENT_DELEGATION_SECRET=
AGENT_CURSOR_SECRET=
AGENT_ACTION_APPROVAL_SECRET=
AGENT_RUNTIME_BASE_URL=
AGENT_MODEL_PROVIDER=openai-compatible
AGENT_MODEL_BASE_URL=
AGENT_MODEL_API_KEY=
AGENT_MODEL_NAME=
