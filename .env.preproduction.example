# Render Singapore 内部 UAT；真实值只填写到 Render Secret，不写入仓库。
NODE_VERSION=24.12.0
NODE_ENV=production
DATABASE_URL=
AUTH_SECRET=
AUTH_TRUST_HOST=true
NEXT_PUBLIC_DEMO_MODE=false
DEPLOYMENT_ENV=uat
AUTH_RATE_LIMIT_MODE=isolated-uat

# 仅供 Render initialDeployHook 首次初始化可丢弃的 UAT 数据库。
DEMO_SEED_ALLOW=1
DEMO_SEED_TARGET_ACK=workbuddy_plm_uat
DEMO_SEED_PASSWORD=
