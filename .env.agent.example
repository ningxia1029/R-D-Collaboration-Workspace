# Agent Worker / WorkBuddy 内部接口配置示例。仅复制到受保护的部署密钥系统，不要提交真实值。
AGENT_RUNTIME_BASE_URL=http://127.0.0.1:3000
AGENT_INTERNAL_SERVICE_SECRET=replace-with-at-least-32-random-bytes
AGENT_DELEGATION_SECRET=replace-with-another-32-random-bytes
AGENT_CURSOR_SECRET=replace-with-another-32-random-bytes
AGENT_ACTION_APPROVAL_SECRET=replace-with-a-fourth-32-random-bytes

AGENT_MODEL_PROVIDER=openai-compatible
AGENT_MODEL_BASE_URL=https://approved-provider.example/v1
AGENT_MODEL_API_KEY=replace-in-secret-manager
AGENT_MODEL_NAME=approved-enterprise-model
# DeepSeek V4 当前生产适配仅启用非思考模式；思考模式 Tool 历史需另行验收。
AGENT_MODEL_THINKING=disabled
AGENT_MODEL_MAX_OUTPUT_TOKENS=2048

# 真实模型评测安全预算；API Key 只通过当前进程或 Secret Manager 注入。
LIVE_AGENT_EVAL_REPEATS=3
LIVE_AGENT_EVAL_TIMEOUT_MS=20000
LIVE_AGENT_EVAL_MAX_COST_MICROS=100000

# 生产必须保持 false 或不设置；true 只用于本地演示，会在登录页显示演示账号。
NEXT_PUBLIC_DEMO_MODE=false

# 文档片段 Outbox 索引器；生产部署应作为独立受控进程运行。
AGENT_KNOWLEDGE_POLL_MS=2000
AGENT_KNOWLEDGE_BATCH_SIZE=25

# 仅限本地验收，不得在生产开启。
AGENT_ALLOW_FAKE_PROVIDER=0
